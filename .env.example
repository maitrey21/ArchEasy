# Copy to .env and fill in. Safe to commit this file (no real values).

# --- Client-side (PUBLIC, shipped in the browser bundle) ---
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# --- Server-side (SECRET, /api only, never in the browser) ---
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Optional. Wall-clock budget the /api functions assume they have, in seconds.
# MUST NOT exceed `functions[].maxDuration` in vercel.json (currently 60), or
# Vercel kills the function first and the browser gets an HTML crash page
# instead of JSON. Raise both together for more headroom on dense drawings:
# 300 is the Hobby maximum once Fluid compute is enabled, 800 on Pro.
# FUNCTION_MAX_DURATION_S="60"
